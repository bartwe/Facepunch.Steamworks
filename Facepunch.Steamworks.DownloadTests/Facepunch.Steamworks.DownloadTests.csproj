<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;DebugLinuxX64</Configurations>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Facepunch.Steamworks/Facepunch.Steamworks.Posix.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>
  <Target Name="BuildSteamUgcStub" AfterTargets="Build">
    <Error Condition="!$([MSBuild]::IsOSPlatform('Linux'))" Text="The download regression tests require Linux and a C compiler (cc)." />
    <Exec Command="cc -shared -fPIC -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/steam_ugc_stub.c&quot; -o &quot;$(TargetDir)libsteam_ugc_stub.so&quot;" />
  </Target>
</Project>
