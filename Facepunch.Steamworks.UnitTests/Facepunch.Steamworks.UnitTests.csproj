<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;DebugLinuxX64</Configurations>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Facepunch.Steamworks/Facepunch.Steamworks.Posix.csproj" />
    <ProjectReference Include="../Generator/Generator.csproj" />
    <None Include="../Generator/steam_sdk/steam_api.json" Link="steam_api.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>
  <Target Name="BuildFakeIPTestShim" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))"
          Inputs="$(MSBuildProjectDirectory)/FakeIPTestShim.c;$(MSBuildProjectFullPath)"
          Outputs="$(TargetDir)libsteam_api.so">
    <Exec Command="cc -std=c11 -shared -fPIC -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/FakeIPTestShim.c&quot; -o &quot;$(TargetDir)libsteam_api.so&quot;" />
  </Target>
</Project>
