<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;DebugLinuxX64</Configurations>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Facepunch.Steamworks/Facepunch.Steamworks.Posix.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>
  <Target Name="BuildServerListStub" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="cc -std=c11 -Wall -Wextra -Werror -shared -fPIC &quot;$(MSBuildProjectDirectory)/Native/server_list_stub.c&quot; -o &quot;$(TargetDir)libserver_list_stub.so&quot;" />
  </Target>
</Project>
