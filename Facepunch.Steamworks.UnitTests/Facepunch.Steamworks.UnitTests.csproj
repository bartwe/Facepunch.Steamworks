<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;DebugLinuxX64</Configurations>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Facepunch.Steamworks/Facepunch.Steamworks.Posix.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>
  <Target Name="BuildInventoryTestStub" BeforeTargets="CopyFilesToOutputDirectory"
          Inputs="$(MSBuildProjectDirectory)/Native/Inventory.c;$(MSBuildProjectFullPath)"
          Outputs="$(TargetDir)libinventory_test.so">
    <Exec Command="cc -shared -fPIC -std=c99 -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/Native/Inventory.c&quot; -o &quot;$(TargetDir)libinventory_test.so&quot;" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)libinventory_test.so" />
    </ItemGroup>
  </Target>
</Project>
